# Copy to .env and export, or set these in your process manager / host.
# All are optional — without provider credentials the app runs in demo mode
# (notifications are logged to the database instead of being delivered).

PORT=3000
# DATA_DIR=./data
# SECRET=change-me-to-a-long-random-string
PAYMENT_DUE_DAYS=7
# Auto-verify payments that pass every automatic check (skip manual review)
AUTO_APPROVE=false

# --- Email via SendGrid ---
# SENDGRID_API_KEY=SG.xxxxx
# EMAIL_FROM=noreply@yourdomain.com

# --- SMS & WhatsApp via Twilio ---
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_SMS_FROM=+15551234567
# TWILIO_WHATSAPP_FROM=+15551234567
